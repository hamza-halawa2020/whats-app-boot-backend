PORT=3000
CORS_ORIGIN=https://your-frontend-domain.com

MYSQL_DATABASE=whatsapp_boot_backend
MYSQL_USER=whatsapp
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000

WWEBJS_AUTH_PATH=/app/.wwebjs_auth
WWEBJS_CACHE_PATH=/app/.wwebjs_cache

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Optional: choose the admin WhatsApp session used to send registration OTPs.
# OTP_SENDER_USER_ID=1
# OTP_SENDER_ADMIN_PHONE=201001234567

SIGNUP_GIFT_POINTS=0
MESSAGE_POINT_COST=1
DAILY_MESSAGE_LIMIT=0
